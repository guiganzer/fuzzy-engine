<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PostgresCommandExecuter</AssemblyName>
    <RootNamespace>PostgresCommandExecuter</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Product>PostgreSQL Command Executer</Product>
    <Company>PostgreSQL Command Executer</Company>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Assets\sql-executor-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.1.x ainda oferece um assembly .NET Framework compatível com o Windows Server 2012. -->
    <PackageReference Include="Npgsql" Version="4.1.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\sql-executor-icon.png" />
    <Resource Include="Assets\sql-executor-icon.png" />
  </ItemGroup>
</Project>

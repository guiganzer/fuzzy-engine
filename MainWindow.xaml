<Window x:Class="PostgresCommandExecuter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="PostgreSQL Command Executer" Width="1180" Height="760"
        Icon="Assets/sql-executor-icon.png"
        MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenSql_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveSql_Executed" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    </Window.InputBindings>

    <DockPanel Background="{DynamicResource WindowBrush}">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Abrir SQL..." Command="ApplicationCommands.Open" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Salvar SQL..." Command="ApplicationCommands.Save" InputGestureText="Ctrl+S" />
                <Separator />
                <MenuItem Header="_Sair" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Consulta">
                <MenuItem Header="_Executar" Click="Execute_Click" InputGestureText="Ctrl+Enter" />
                <MenuItem Header="_Formatar SQL" Click="FormatSql_Click" InputGestureText="Ctrl+Shift+F" />
                <MenuItem Header="_Cancelar" Click="Cancel_Click" />
            </MenuItem>
            <MenuItem Header="_Tema">
                <MenuItem Header="_Escuro" Click="DarkTheme_Click" />
                <MenuItem Header="_Claro" Click="LightTheme_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel>
                    <TextBlock Text="CONEXÃO LOCAL" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="PostgreSQL" FontSize="21" FontWeight="SemiBold" Margin="0,4,0,18" />

                    <TextBlock Text="Servidor" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox Text="127.0.0.1" IsReadOnly="True" Margin="0,0,0,12" ToolTip="Conexões remotas são bloqueadas." />
                    <TextBlock Text="Porta" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="PortTextBox" Text="55432" Margin="0,0,0,12" />
                    <TextBlock Text="Banco" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="DatabaseTextBox" Text="postgres_executor_dev" Margin="0,0,0,12" />
                    <TextBlock Text="Usuário" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <TextBox x:Name="UserTextBox" Text="executor_dev" Margin="0,0,0,12" />
                    <TextBlock Text="Senha" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="PasswordInput" Margin="0,0,0,16" />
                    <Button Content="Testar conexão" Click="TestConnection_Click" Margin="0" />

                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Proteção ativa" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="Somente 127.0.0.1 e ::1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="QueryRow" Height="*" MinHeight="0" />
                    <RowDefinition x:Name="SplitterRow" Height="8" />
                    <RowDefinition x:Name="ResultsRow" Height="1.15*" MinHeight="0" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <Border x:Name="QueryPanel" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="☆ Favoritar" Click="AddFavorite_Click" ToolTip="Salvar seleção ou consulta atual" />
                                    <Button x:Name="FavoritesButton" Content="★ Favoritos ▾" Click="ShowFavorites_Click"
                                            ToolTip="Abrir catálogo pessoal de consultas" />
                                    <Button Content="⇥ Formatar" Click="FormatSql_Click" ToolTip="Formatar SQL sem alterar literais (Ctrl+Shift+F)" />
                                    <Button x:Name="ThemeButton" Content="☀ Tema claro" Click="ToggleTheme_Click" ToolTip="Alternar tema claro/escuro" />
                                    <Button x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click" IsEnabled="False" />
                                    <Button x:Name="ExecuteButton" Content="▶ Executar" Style="{StaticResource PrimaryButton}" Click="Execute_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Consulta SQL" FontWeight="SemiBold" />
                                    <TextBlock Text="  Ctrl+Enter" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                    <TextBlock x:Name="SqlAnalysisText" Text="  •  PostgreSQL" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <avalon:TextEditor x:Name="SqlEditor" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           BorderThickness="0" FontFamily="Consolas" FontSize="14" ShowLineNumbers="True"
                                           WordWrap="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                           TextChanged="SqlEditor_TextChanged" />
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="QueryResultSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                              Background="Transparent" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

                <Grid x:Name="ResultPanel" Grid.Row="2">
                    <TabControl x:Name="ResultTabs">
                        <TabItem Header="Resultado">
                            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.IsDeferredScrollingEnabled="True" ScrollViewer.CanContentScroll="True"
                                      GridLinesVisibility="Horizontal" BorderThickness="0"
                                      HeadersVisibility="All" ClipboardCopyMode="IncludeHeader"
                                      PreviewMouseLeftButtonDown="ResultsGrid_PreviewMouseLeftButtonDown"
                                      PreviewMouseWheel="ResultsGrid_PreviewMouseWheel" />
                        </TabItem>
                        <TabItem Header="JSON">
                            <avalon:TextEditor x:Name="JsonViewer" IsReadOnly="True" Background="{DynamicResource InputBrush}"
                                               Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0"
                                               FontFamily="Consolas" FontSize="13" ShowLineNumbers="True" WordWrap="False"
                                               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Mensagens">
                            <TextBox x:Name="MessagesTextBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas"
                                     Padding="14" BorderThickness="0" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                        </TabItem>
                    </TabControl>
                    <Button x:Name="ExpandResultsButton" Content="↗ Expandir" Click="ToggleResultsPanel_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,6,0" Padding="10,5"
                            Panel.ZIndex="10" ToolTip="Expandir resultados (Ctrl+Shift+Espaço)" />
                </Grid>

                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,8,4,0">
                    <DockPanel>
                        <TextBlock x:Name="ConnectionStatusText" Text="● Desconectado" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="StatusText" Text="Pronto" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

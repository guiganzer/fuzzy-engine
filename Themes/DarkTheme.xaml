<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Graphite/Zinc: superfícies realmente neutras, sem dominante azul. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#171717" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#202020" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="InputBrush" Color="#141414" />
    <SolidColorBrush x:Key="BorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#5AA7D9" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#82C1E8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#101820" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#344B5A" />
    <SolidColorBrush x:Key="GridAlternateBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="MenuBarBrush" Color="#29343A" />
    <SolidColorBrush x:Key="MenuBarBorderBrush" Color="#45616F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="SqlKeywordBrush" Color="#67E8F9" />
    <SolidColorBrush x:Key="SqlStringBrush" Color="#FDBA74" />
    <SolidColorBrush x:Key="SqlNumberBrush" Color="#C4B5FD" />
    <SolidColorBrush x:Key="SqlCommentBrush" Color="#86EFAC" />
    <!-- O template nativo do WPF consulta estes recursos dentro dos pop-ups. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F5F5F5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#333333" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F5F5F5" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#202020" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F5F5F5" />
    <sys:String x:Key="ThemeName" xmlns:sys="clr-namespace:System;assembly=mscorlib">Dark</sys:String>
</ResourceDictionary>

<Window x:Class="PostgresCommandExecuter.CellValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valor da célula" Width="720" Height="460" MinWidth="360" MinHeight="240"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="Assets/sql-executor-icon.png"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <TextBox x:Name="CellValueTextBox"
                 Margin="12"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13" Padding="10"
                 ToolTip="Ctrl+C copia a seleção. Ctrl+Enter aplica a alteração." />

        <Button x:Name="ToggleWorkspaceButton" Content="↗" Width="28" Height="28"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,14"
                Padding="0" FontSize="14" FontWeight="SemiBold"
                ToolTip="Ocupar a área útil da tela"
                Click="ToggleWorkspace_Click" />
    </Grid>
</Window>
